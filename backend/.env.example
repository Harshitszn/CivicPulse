# ─────────────────────────────────────────────
# CivicPulse Backend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL (with PostGIS) ─────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/civicpulse

# ── JWT ───────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary (Image Uploads) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Service ────────────────────────────────
AI_SERVICE_URL=http://localhost:8000/api/classify
AI_SERVICE_API_KEY=your_ai_service_key

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
