# ─────────────────────────────────────────────
# CivicPulse Backend — Local Development .env
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL (with PostGIS) ─────────────────
DATABASE_URL=postgresql://postgres.niwnlixzwmpqtliahjne:Harshit%40321go@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
# ── JWT ───────────────────────────────────────
JWT_SECRET=civicpulse_dev_jwt_secret_change_in_production_min64chars_xxxxxxxxxxx
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=civicpulse_dev_refresh_secret_change_in_production_min64chars_xxx
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary (Image Uploads) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Service ────────────────────────────────
AI_SERVICE_URL=http://localhost:8000/api/classify
AI_SERVICE_API_KEY=dev_ai_key

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
